@prefix ex: <https://example.org/medigraph-validation/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
ex:ScopeShape a sh:NodeShape; sh:targetClass ex:Claim;
 sh:property [sh:path ex:kind; sh:minCount 1; sh:maxCount 1; sh:hasValue "documentary_association"];
 sh:property [sh:path ex:time; sh:minCount 1; sh:maxCount 1; sh:hasValue "frozen_documentary"];
 sh:property [sh:path ex:snapshot; sh:minCount 1; sh:maxCount 1; sh:equals ex:availableSnapshot].
